---
import Site from '../../layouts/Site.astro';
import { person } from '../../data/profile';
const name = person.name;
import { getPosts, longDate } from '../../data/buildFs';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Site section="writing" title={`${post.data.title} - ${name}`} description={post.data.description}>
  <article class="article">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString()}>{longDate(post.data.date)}</time>
    </header>
    <Content />
    <p class="back"><a href={`${import.meta.env.BASE_URL}#writing`}>All writing</a></p>
  </article>
</Site>
