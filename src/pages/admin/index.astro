---
import Admin from '../../layouts/Admin.astro';
import { api } from '../../data/api';
const base = import.meta.env.BASE_URL;
// the content files, in the order the nav lists them (src/data/content/*.json)
const content = [
  ['profile', 'profile & links'],
  ['projects', 'projects'],
  ['homelab', 'homelab'],
  ['cv', 'cv'],
  ['productions', 'productions'],
  ['terminal', 'terminal files'],
];
---

<Admin>
  <form slot="top" class="adm-login" data-login data-api={api} data-base={base}>
    <label>
      <span class="sr-only">admin token</span>
      <input name="token" type="password" placeholder="admin token" autocomplete="current-password" required disabled={!api} />
    </label>
    <button class="btn btn-primary" type="submit" disabled={!api}>Log in</button>
    <button class="btn" type="button" data-logout hidden>Log out</button>
  </form>

  <nav class="adm-nav" aria-label="Admin">
    <a href="#overview">overview</a>
    <a href="#posts">posts</a>
    <p class="adm-nav-group">content</p>
    {content.map(([id, label]) => <a class="adm-sub" href={`#content/${id}`}>{label}</a>)}
    <a href="#guestbook">guestbook</a>
    <a href="#wall">wall</a>
    <a href="#visits">visits</a>
    <a class="adm-out" href={base}>view the site ↗</a>
  </nav>

  <main class="adm-main">
    <p class="adm-live" role="status" aria-live="polite" data-live>{api ? 'Log in with the worker’s ADMIN_TOKEN. It’s only kept in this browser.' : 'The API isn’t set in this build (PUBLIC_API), so there’s nothing to manage.'}</p>
    <noscript><p>The admin needs JavaScript.</p></noscript>

    <section data-panel="overview" aria-labelledby="ov-h" hidden>
      <h1 id="ov-h" class="adm-h">Overview</h1>
      <div class="adm-tiles" data-tiles></div>
      <p class="adm-actions">
        <a class="btn btn-primary" href="#posts/new">New post</a>
        <a class="btn" href="#content/profile">Edit profile</a>
        <a class="btn" href="#guestbook">Messages</a>
      </p>
    </section>

    <section data-panel="posts" aria-labelledby="posts-h" hidden>
      <div data-post-index>
        <header class="adm-head">
          <h1 id="posts-h" class="adm-h">Posts</h1>
          <a class="btn btn-primary" href="#posts/new">New post</a>
        </header>
        <p class="adm-note">Saving commits the post to <code>main</code>, and the site redeploys in about two minutes. Drafts stay off the live site.</p>
        <ol class="adm-list" data-post-list></ol>
      </div>
      <form class="md-editor" data-post-form hidden>
        <header class="md-bar">
          <a class="text-btn" href="#posts">← all posts</a>
          <span class="md-state" data-post-state></span>
          <span class="md-bar-end">
            <button class="btn" type="button" data-post-delete>Delete</button>
            <button class="btn btn-primary" type="submit">Save</button>
          </span>
        </header>
        <div class="md-meta">
          <label class="gb-field"><span>title</span><input name="title" required autocomplete="off" /></label>
          <label class="gb-field"><span>slug <em>/blog/slug/</em></span><input name="slug" required pattern="[a-z0-9][a-z0-9\-]{0,80}" autocomplete="off" spellcheck="false" /></label>
          <label class="gb-field"><span>date</span><input name="date" type="date" required /></label>
          <label class="gb-field md-desc"><span>description <em>under the title in lists and link previews</em></span><input name="description" required autocomplete="off" /></label>
          <label class="md-draft"><input name="draft" type="checkbox" /> draft</label>
        </div>
        <div class="md-tools" role="toolbar" aria-label="Formatting">
          <button type="button" data-md="bold" title="bold (ctrl+b)"><b>B</b></button>
          <button type="button" data-md="italic" title="italic (ctrl+i)"><i>I</i></button>
          <button type="button" data-md="h2" title="heading">H2</button>
          <button type="button" data-md="h3" title="subheading">H3</button>
          <button type="button" data-md="link" title="link (ctrl+k)">link</button>
          <button type="button" data-md="quote" title="quote">“ ”</button>
          <button type="button" data-md="code" title="code">`code`</button>
          <button type="button" data-md="list" title="list">• list</button>
          <button type="button" data-md="image" title="add images (or paste / drop them in)">+ image</button>
          <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden data-md-file />
          <span class="md-tabs" role="group" aria-label="Show">
            <button type="button" data-md-view="write" aria-pressed="true">write</button>
            <button type="button" data-md-view="preview" aria-pressed="false">preview</button>
          </span>
        </div>
        <div class="md-split" data-view="write">
          <label class="md-pane md-write">
            <span class="sr-only">markdown</span>
            <textarea name="body" spellcheck="true" placeholder="Write in markdown. Paste or drop images straight in."></textarea>
          </label>
          <div class="md-pane md-preview" data-preview aria-label="Preview">
            <article class="article">
              <header><h1 data-pv-title></h1><time data-pv-date></time></header>
              <div data-pv-body></div>
            </article>
          </div>
        </div>
      </form>
    </section>

    <section data-panel="content" aria-labelledby="content-h" hidden>
      <header class="adm-head">
        <h1 id="content-h" class="adm-h" data-content-title>Content</h1>
        <span class="adm-head-end">
          <span class="adm-switch" role="group" aria-label="Edit as">
            <button type="button" data-content-view="form" aria-pressed="true">form</button>
            <button type="button" data-content-view="json" aria-pressed="false">json</button>
          </span>
          <button class="btn" type="button" data-content-revert disabled>Revert</button>
          <button class="btn btn-primary" type="button" data-content-save disabled>Save</button>
        </span>
      </header>
      <p class="adm-note">Text can hold <code>[text](url)</code> links (<code>#project-x</code> links to a section). The terminal files are html. Saving commits to <code>main</code>; live in about two minutes.</p>
      <div class="cf" data-content-form></div>
      <label class="gb-field cf-json" hidden><span class="sr-only">json</span><textarea data-content-json spellcheck="false"></textarea></label>
    </section>

    <section data-panel="guestbook" aria-labelledby="gb-h" hidden>
      <h1 id="gb-h" class="adm-h">Guestbook</h1>
      <ol class="gb-list gb-admin" data-gb-list></ol>
    </section>

    <section data-panel="wall" aria-labelledby="wall-h" hidden>
      <header class="adm-head">
        <h1 id="wall-h" class="adm-h">Wall</h1>
        <button type="button" class="btn" data-wall-clear>Clear the whole wall</button>
      </header>
      <ol class="gb-list wall-admin" data-wall-list></ol>
    </section>

    <section data-panel="visits" class="stats" aria-labelledby="stats-h" hidden>
      <header class="adm-head">
        <h1 id="stats-h" class="adm-h">Visits</h1>
        <p class="stats-range" role="group" aria-label="Range">
          <button type="button" class="text-btn" data-days="7">7d</button>
          <button type="button" class="text-btn" data-days="30" aria-pressed="true">30d</button>
          <button type="button" class="text-btn" data-days="90">90d</button>
        </p>
      </header>
      <p class="stats-sum" data-stats-sum></p>
      <div class="stats-chart" data-stats-chart></div>
      <details class="stats-table">
        <summary>by day, as a table</summary>
        <table data-stats-daily><thead><tr><th>day</th><th>loads</th><th>visitors</th></tr></thead><tbody></tbody></table>
      </details>
      <div class="stats-tops">
        <table data-stats-pages><caption>pages</caption><thead><tr><th>path</th><th>loads</th><th>visitors</th></tr></thead><tbody></tbody></table>
        <table data-stats-refs><caption>referrers</caption><thead><tr><th>from</th><th>loads</th></tr></thead><tbody></tbody></table>
        <table data-stats-countries><caption>countries</caption><thead><tr><th>where</th><th>visitors</th></tr></thead><tbody></tbody></table>
      </div>
      <details class="stats-table">
        <summary data-stats-recent-sum>latest page loads</summary>
        <ol class="gb-list stats-recent" data-stats-recent></ol>
      </details>
    </section>
  </main>
</Admin>

<script>
  import { start } from '../../scripts/admin/main';
  start();
</script>
