---
import Site from '../layouts/Site.astro';
import Pipeline from '../components/Pipeline.astro';
import Productions from '../components/Productions.astro';
import ProjectTeasers from '../components/ProjectTeasers.astro';
import CvGlance from '../components/CvGlance.astro';
import GuestbookTeaser from '../components/GuestbookTeaser.astro';
import { person, links, featured, archive, homelab, productions } from '../data/profile';
import { getPosts, longDate } from '../data/buildFs';
import { inline } from '../data/inline';

// home is the skim: every section is a teaser with the strongest bits, and
// a link to its full page. the full content lives on those pages.
const posts = await getPosts();
const base = import.meta.env.BASE_URL;
const ft = homelab.failureTest;
const email = links[0];
---

<Site boot>
  <section id="about" class="hero" aria-labelledby="about-h">
    <p class="hero-kicker"><span class="prompt-sym" aria-hidden="true">$</span> whoami</p>
    <h1 id="about-h" class="hero-h">{person.headline}</h1>
    <div class="hero-body">
      {person.intro.map((p) => <p set:html={inline(p)} />)}
    </div>
    <div class="open">
      <span class="status status-live"><span class="status-dot" aria-hidden="true" />Open to work</span>
      <p>{person.lookingFor}</p>
    </div>
    <div class="cta">
      <a class="btn btn-primary" href={email.href}>Email me</a>
      {links.slice(1).map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
    </div>
    <dl class="facts">
      <div><dt>Studying</dt><dd>King's College London<br />Computer Science<br />Year 2</dd></div>
      <div><dt>Average</dt><dd>79.6%, predicted First</dd></div>
      <div><dt>Society</dt><dd>Treasurer, KCL Cyber Security Society</dd></div>
      <div><dt>Last internship</dt><dd>Infrastructure / Cloud, Elecosoft</dd></div>
    </dl>
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <header class="section-head">
      <h2 id="projects-h" class="section-h"><a class="head-link" href={`${base}projects/`}>Projects</a></h2>
      <span class="section-meta">{featured.length + archive.length} projects</span>
    </header>
    <p class="section-lede">Three I'd most like to talk about. Every project, with the details, is on the projects page.</p>
    <ProjectTeasers featured={featured} archive={archive} />
    <p class="more"><a href={`${base}projects/`}>All {featured.length + archive.length} projects, with details and filters</a></p>
  </section>

  <section id="homelab" aria-labelledby="homelab-h">
    <header class="section-head">
      <h2 id="homelab-h" class="section-h"><a class="head-link" href={`${base}homelab/`}>Homelab</a></h2>
      <span class="section-meta">2 machines, 1 pipeline</span>
    </header>
    <p class="section-lede">
      alexandria is where my projects actually run. Every change reaches it through a pipeline I built, and a monitor I
      wrote tells me when something breaks. Then I broke it on purpose to time the alerts.
    </p>
    <Pipeline />
    <dl class="readout readout-home">
      <div><dt>Failure trials</dt><dd>{ft.trials}</dd></div>
      <div><dt>Up/down changes caught</dt><dd>{ft.transitions}</dd></div>
      <div><dt>Mean time to alert</dt><dd>{ft.meanAlert}</dd></div>
      <div><dt>Poll interval</dt><dd>{ft.pollInterval}</dd></div>
    </dl>
    <p class="more"><a href={`${base}homelab/#failure-drill`}>Why 2 were missed, the raw timings, and both machines</a></p>
  </section>

  <section id="cv" aria-labelledby="cv-h">
    <header class="section-head">
      <h2 id="cv-h" class="section-h"><a class="head-link" href={`${base}cv/`}>CV</a></h2>
      <span class="section-meta">at a glance</span>
    </header>
    <CvGlance />
    <p class="more"><a href={`${base}cv/`}>The full CV: every role, award and skill</a></p>
  </section>

  <section id="productions" aria-labelledby="productions-h">
    <header class="section-head">
      <h2 id="productions-h" class="section-h"><a class="head-link" href={`${base}productions/`}>Productions</a></h2>
      <span class="section-meta">lighting and sound since 2021</span>
    </header>
    <p class="section-lede">Away from the keyboard I'm in the lighting booth: about 14 productions at school, and now King's Tech Crew.</p>
    <Productions items={productions.slice(0, 3)} />
    <p class="more"><a href={`${base}productions/`}>All {productions.length} named productions</a></p>
  </section>

  <section id="writing" aria-labelledby="writing-h">
    <header class="section-head">
      <h2 id="writing-h" class="section-h"><a class="head-link" href={`${base}blog/`}>Writing</a></h2>
      <span class="section-meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </header>
    {posts.length ? (
      <ul class="post-list">
        {posts.slice(0, 3).map((p) => (
          <li>
            <a href={`${base}blog/${p.id}/`}>{p.data.title}</a>
            <time datetime={p.data.date.toISOString()}>{longDate(p.data.date)}</time>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ul>
    ) : <p>Nothing published yet.</p>}
    <p class="more"><a href={`${base}blog/`}>All writing, and the RSS feed</a></p>
  </section>

  <section id="guestbook" aria-labelledby="guestbook-h">
    <header class="section-head">
      <h2 id="guestbook-h" class="section-h"><a class="head-link" href={`${base}guestbook/`}>Guestbook</a></h2>
      <span class="section-meta" data-gb-meta>say hello</span>
    </header>
    <GuestbookTeaser />
  </section>

  <section id="contact" aria-labelledby="contact-h">
    <header class="section-head">
      <h2 id="contact-h" class="section-h">Contact</h2>
      <span class="section-meta">email is fastest</span>
    </header>
    <dl class="contact">
      {links.map((l) => <><dt>{l.label}</dt><dd><a href={l.href}>{l.text}</a></dd></>)}
    </dl>
  </section>
</Site>
