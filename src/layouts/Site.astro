---
import '../styles/tokens.css';
import '../styles/terminal.css';
import '../styles/site.css';
import { person, links } from '../data/profile';
import { buildFs } from '../data/buildFs';
import BootSequence from '../components/BootSequence';
import QuakeTerminal from '../components/QuakeTerminal';
import SectionNav from '../components/SectionNav';
import Uptime from '../components/Uptime';
import ModMark from '../components/ModMark.astro';
import { api } from '../data/api';
import { build } from '../data/build';
import { cardFor } from '../data/og';
import { ldJson } from '../data/seo';
import { defaults as motion, testSite } from '../data/motion';
import MotionPanel from '../components/MotionPanel.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  // only the home page plays the boot animation
  boot?: boolean;
  // nav item to highlight on pages without the home sections
  section?: string;
  // keep the page out of search results (the guestbook admin, 404)
  noindex?: boolean;
  // schema.org structured data for this page (src/data/seo.ts)
  jsonld?: object | object[];
  // a blog post: og:type article, with its date
  published?: Date;
}

const {
  title = `${person.name} | SRE, software and security`,
  description = `${person.name}: ${person.study}. Projects, homelab, experience and writing.`,
  boot = false,
  section,
  noindex = false,
  jsonld,
  published,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const base = import.meta.env.BASE_URL;
const fs = await buildFs();
// this page's share card (src/data/og.ts); home keeps the hand-made og.png
const card = await cardFor(Astro.url.pathname);
const ogImage = new URL(card ? `${base}og/${card.slug}.png` : `${base}og.png?v=2`, Astro.site);
const ogAlt = card
  ? `${card.title}, modul0.dev: ${card.description}`
  : "Zain Rizwan, modul0.dev: I like breaking things (CTFs) and building things that don't break.";

// the tree mirrors home: files (about, contact) scroll to a home section,
// directories open their full page. home has a teaser for each directory with
// the same id, so the highlight follows you down home too. cv/ is a folder on
// desktop (its children only show while you're in it); on narrow screens the
// folder flattens away and its children sit in the grid like everything else.
const sections = [
  { id: 'about', label: 'about' },
  { id: 'projects', label: 'projects/', href: `${base}projects/` },
  { id: 'homelab', label: 'homelab/', href: `${base}homelab/` },
  {
    id: 'cv',
    label: 'cv/',
    href: `${base}cv/`,
    children: ['experience', 'education', 'leadership', 'awards', 'skills'].map((id) => ({ id, label: id, href: `${base}cv/#${id}` })),
  },
  { id: 'productions', label: 'productions/', href: `${base}productions/` },
  { id: 'writing', label: 'writing/', href: `${base}blog/` },
  { id: 'guestbook', label: 'guestbook/', href: `${base}guestbook/` },
  { id: 'contact', label: 'contact' },
];
---

<!doctype html>
<html lang="en-GB" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta property="og:site_name" content="modul0" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {published && <meta property="article:author" content={person.name} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <script type="application/ld+json" set:html={ldJson(jsonld)} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={person.name} href={`${base}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- page changes swap the content in place: the rail, the terminal (and its
         session) and the motion panel stay alive, nothing reloads. no
         animation (transition:animate on <html>) -->
    <ClientRouter />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <script is:inline define:vars={{ boot, motion, testSite }}>
      // at the very top of body, not in head: here it runs after the head's
      // stylesheets have loaded. in head it ran first, and firefox, asked
      // for matchMedia before the css arrived, painted one frame of the page
      // unstyled (a screen-wide % slash). still before any content paints:
      // how the site moves (data-motion, data-mx-*; the
      // test site's panel overrides the defaults per browser), and whether the
      // boot animation runs, so the page never flashes underneath either.
      // both fail open after a few seconds if the scripts never load.
      var root = document.documentElement;
      // theme: dark unless this browser chose light (src/scripts/theme.ts)
      try {
        if (localStorage.getItem('modul0-theme') === 'light') {
          root.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#ffffff');
        }
      } catch (e) {}
      var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var m = Object.assign({}, motion);
      try {
        if (testSite) Object.assign(m, JSON.parse(localStorage.getItem('modul0-motion') || '{}'));
      } catch (e) {}
      root.dataset.motion = m.style;
      ['reveal', 'cursor', 'decode'].forEach(function (x) {
        if (m[x]) root.setAttribute('data-mx-' + x, '');
      });
      try {
        // the test site replays the boot on every load (a real load: not when
        // the router swaps home in, which sets __modul0Nav)
        if (boot && !window.__modul0Nav && (testSite || !sessionStorage.getItem('modul0-booted')) && !reduced) {
          root.dataset.boot = 'pending';
          setTimeout(function () {
            if (root.dataset.boot === 'pending') delete root.dataset.boot;
          }, 5000);
        }
      } catch (e) {}
    </script>
    <a class="skip" href="#main">Skip to content</a>
    {boot && <div class="boot-cover" aria-hidden="true" />}
    {boot && <BootSequence client:load />}

    <div class="shell">
      <aside class="rail" transition:persist="rail">
        <a class="rail-name" href={base}>{person.name.toLowerCase()}<ModMark /></a>
        <!-- shown by the script below: without js it can't do anything -->
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Light mode" hidden>
          <span class="theme-dark">dark</span><span class="theme-light">light</span>
        </button>
        <p class="rail-study">{person.study}</p>
        <SectionNav client:load items={sections} base={base} initial={section} />
        <dl class="rail-facts">
          <div>
            <dt>now</dt>
            <dd>{person.now}</dd>
          </div>
          <div>
            <dt>uptime</dt>
            <dd class="mono"><Uptime client:idle birth={person.birth} /></dd>
          </div>
          <div data-views hidden>
            <dt>visits</dt>
            <dd class="mono" data-views-n></dd>
          </div>
        </dl>
        <ul class="rail-links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <a class="rail-terminal" href={`${base}terminal/`} data-open-terminal data-astro-reload>
          <span aria-hidden="true">&gt;_</span> Open the terminal <kbd>`</kbd>
        </a>
      </aside>

      <main id="main">
        <slot />
        <footer class="site-footer">
          <p>
            Built with Astro and React, deployed by GitHub Actions. There's a terminal hidden in here: <span class="kbd-hint">press <kbd>`</kbd>&nbsp;on any page, or </span><a href={`${base}terminal/`} data-open-terminal data-astro-reload>open it</a>. <span class="kbd-hint">The page takes vim keys too: <kbd>j</kbd>&nbsp;and <kbd>k</kbd>&nbsp;jump between sections, <kbd>/</kbd>&nbsp;searches, <kbd>?</kbd>&nbsp;lists the rest. </span>The <a href="https://github.com/iamzainrizwan/modul0/releases/tag/v0-handwritten">first version</a> of this site was hand-written.
          </p>
          <p class="footer-sign">
            <ModMark /> modul0.dev<span data-views hidden> · <span data-views-n></span> visits</span>
            {build.short && (
              <span class="footer-build"> · updated <time datetime={build.at} data-ago>{new Date(build.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}</time> · <a href={build.url} title="the commit this build came from">{build.short}</a></span>
            )}
          </p>
        </footer>
      </main>
    </div>

    <QuakeTerminal client:idle fs={fs} transition:persist="quake" />
    <!-- every key the site answers to, on ? (the script below). a native
         dialog: esc and the x close it, focus comes back on its own -->
    <dialog class="keys" aria-labelledby="keys-h" transition:persist="keys">
      <div class="keys-bar">
        <h2 id="keys-h">keys</h2>
        <form method="dialog"><button class="keys-close" aria-label="Close">×</button></form>
      </div>
      <dl class="keys-list">
        <div><dt><kbd>`</kbd></dt><dd>open or close the terminal</dd></div>
        <div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>next or previous section</dd></div>
        <div><dt><kbd>g</kbd><kbd>g</kbd> <kbd>G</kbd></dt><dd>top or bottom of the page</dd></div>
        <div><dt><kbd>/</kbd></dt><dd>search everything (a grep in the terminal)</dd></div>
        <div><dt><kbd>?</kbd></dt><dd>this list</dd></div>
        <div><dt><kbd>esc</kbd></dt><dd>close whatever's open</dd></div>
      </dl>
      <p class="keys-more">In the terminal, <code>help</code> lists the commands. Not all of them: try what you'd try on a real one, and <code>eggs</code> keeps score.</p>
    </dialog>
    {testSite && <MotionPanel />}
    <script is:inline define:vars={{ api }}>
      // the view counter: one visit per browser session, shown in the rail and footer
      if (api) {
        var counted = false;
        try { counted = !!sessionStorage.getItem('modul0-counted'); } catch (e) {}
        fetch(api + '/views', { method: counted ? 'GET' : 'POST' })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (d) {
            try { sessionStorage.setItem('modul0-counted', '1'); } catch (e) {}
            var n = Number(d.views).toLocaleString('en-GB');
            document.querySelectorAll('[data-views-n]').forEach(function (el) { el.textContent = n; });
            document.querySelectorAll('[data-views]').forEach(function (el) { el.hidden = false; });
          })
          .catch(function () {});
      }
    </script>
    <script>
      import { initMotion } from '../scripts/motion';
      import { getTheme, setTheme } from '../scripts/theme';
      initMotion();

      // the theme toggle lives in the persisted rail, so this wires it once;
      // the terminal's `theme` command fires modul0:theme too
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const sync = () => toggle.setAttribute('aria-pressed', String(getTheme() === 'light'));
      toggle.hidden = false;
      sync();
      toggle.addEventListener('click', () => setTheme(getTheme() === 'light' ? 'dark' : 'light'));
      window.addEventListener('modul0:theme', sync);

      // the router swaps in each new page's <html> attributes, which don't have
      // the motion settings (the pre-paint script sets those at runtime): carry
      // them over, and mark the swap so that script skips the boot
      document.addEventListener('astro:before-preparation', () => ((window as any).__modul0Nav = true));
      document.addEventListener('astro:before-swap', (e: any) => {
        const next = e.newDocument.documentElement as HTMLElement;
        for (const a of [...document.documentElement.attributes]) {
          if (a.name === 'data-motion' || a.name === 'data-theme' || a.name.startsWith('data-mx-')) next.setAttribute(a.name, a.value);
        }
      });

      // the footer's "updated" stamp reads as time ago (the date without js).
      // the footer is swapped with each page, so on every page-load
      const ago = () => {
        for (const t of document.querySelectorAll<HTMLTimeElement>('time[data-ago]')) {
          const s = (Date.now() - Date.parse(t.dateTime)) / 1000;
          if (!(s >= 0) || s > 30 * 86400) continue;
          t.textContent = s < 60 ? 'just now' : s < 3600 ? `${Math.floor(s / 60)}m ago` : s < 86400 ? `${Math.floor(s / 3600)}h ago` : `${Math.floor(s / 86400)}d ago`;
        }
      };
      ago();
      document.addEventListener('astro:page-load', ago);

      // vim keys on the page: j/k jump between headings, gg/G to the top and
      // bottom, / opens the terminal on a grep. never while typing, never with
      // a modifier, never while the terminal's open
      let lastG = 0;
      document.addEventListener('keydown', (e) => {
        if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
        if ((e.target as HTMLElement).closest?.('input, textarea, select, [contenteditable]')) return;
        if (document.querySelector('.quake.is-open')) return;
        const keys = document.querySelector<HTMLDialogElement>('dialog.keys')!;
        if (keys.open) {
          // the terminal takes over from the list
          if (e.key === '`') keys.close();
          return;
        }
        if (e.key === '?') {
          e.preventDefault();
          keys.showModal();
        } else if (e.key === 'j' || e.key === 'k') {
          const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          const heads = [...document.querySelectorAll<HTMLElement>('main :is(h1, h2, h3)')].filter((h) => h.offsetParent !== null);
          const top = (h: HTMLElement) => h.getBoundingClientRect().top - pad;
          const next = e.key === 'j' ? heads.find((h) => top(h) > 2) : heads.filter((h) => top(h) < -2).pop();
          if (!next) return;
          e.preventDefault();
          next.scrollIntoView({ block: 'start' });
        } else if (e.key === 'G') {
          e.preventDefault();
          scrollTo(0, document.documentElement.scrollHeight);
        } else if (e.key === 'g') {
          if (Date.now() - lastG < 500) {
            scrollTo(0, 0);
            lastG = 0;
          } else lastG = Date.now();
        } else if (e.key === '/' && (window as any).__quakeReady) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('modul0:terminal', { detail: { input: 'grep ' } }));
        }
      });

      // terminal links open the drop-down once it's hydrated, else fall back to /terminal/
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('[data-open-terminal]');
        if (!a || !(window as any).__quakeReady || (e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey) return;
        e.preventDefault();
        window.dispatchEvent(new Event('modul0:terminal'));
      });
    </script>
  </body>
</html>
