---
// test site only (PUBLIC_TEST=1): switch how the site moves, per browser.
// one reveal style, one boot outro (picking one replays the boot), plus
// independent extras; saved in localStorage, read before paint by the
// script at the top of Site.astro's body. * marks what the live site uses.
import { styles, outros, extras, defaults } from '../data/motion';
const base = import.meta.env.BASE_URL;
const groups = [['name', 'from the name'], ['fps', '60fps'], ['dither', 'dither'], ['sweep', 'sweeps']] as const;
---

<details class="mpanel" data-base={base} data-defaults={JSON.stringify(defaults)} transition:persist="mpanel">
  <summary>motion</summary>
  <form>
    <fieldset>
      <legend>boot outro <button type="button" class="mpanel-link" data-boot>replay</button></legend>
      {groups.map(([g, name]) => (
        <div class="mpanel-group">
          <span class="mpanel-sub">{name}</span>
          <div class="mpanel-grid">
            {outros.filter((o) => o.group === g).map((o) => (
              <label class:list={{ 'is-default': o.id === defaults.outro }}><input type="radio" name="outro" value={o.id} /> <span>{o.label}</span></label>
            ))}
          </div>
        </div>
      ))}
    </fieldset>
    <fieldset>
      <legend>style</legend>
      <div class="mpanel-grid">
        {styles.map((s) => (
          <label class:list={{ 'is-default': s.id === defaults.style }}><input type="radio" name="style" value={s.id} /> <span>{s.label}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset>
      <legend>extras</legend>
      <div class="mpanel-grid mpanel-one">
        {extras.map((x) => (
          <label class:list={{ 'is-default': defaults[x.id] }}><input type="checkbox" name={x.id} /> <span>{x.label}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="mpanel-actions">
      <span class="mpanel-note">* live default</span>
      <button type="button" data-reset>reset</button>
    </div>
  </form>
</details>

<script>
  const KEY = 'modul0-motion';
  const panel = document.querySelector<HTMLDetailsElement>('.mpanel')!;
  const form = panel.querySelector('form')!;
  const defaults = JSON.parse(panel.dataset.defaults!);
  const html = document.documentElement;

  const load = () => {
    try { return { ...defaults, ...JSON.parse(localStorage.getItem(KEY) ?? '{}') }; } catch { return { ...defaults }; }
  };
  const save = (m: Record<string, unknown>) => { try { localStorage.setItem(KEY, JSON.stringify(m)); } catch {} };

  // css-driven motion changes straight away; the page draw and scroll reveal
  // are set up at load, so they show from the next page on
  const apply = (m: Record<string, unknown>) => {
    html.dataset.motion = String(m.style);
    html.dataset.outro = String(m.outro);
    for (const k of Object.keys(defaults)) if (k !== 'style' && k !== 'outro') html.toggleAttribute(`data-mx-${k}`, !!m[k]);
  };
  const fill = (m: Record<string, unknown>) => {
    for (const el of form.querySelectorAll<HTMLInputElement>('input')) el.checked = el.type === 'radio' ? el.value === m[el.name] : !!m[el.name];
  };

  fill(load());
  try { panel.open = localStorage.getItem(`${KEY}-open`) !== '0'; } catch { panel.open = true; }
  panel.addEventListener('toggle', () => { try { localStorage.setItem(`${KEY}-open`, panel.open ? '1' : '0'); } catch {} });

  const replay = () => location.assign(panel.dataset.base!);
  form.addEventListener('change', (e) => {
    const radio = (n: string) => (form.elements.namedItem(n) as RadioNodeList).value;
    const m: Record<string, unknown> = { style: radio('style'), outro: radio('outro') };
    for (const el of form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')) m[el.name] = el.checked;
    save(m);
    apply(m);
    // an outro is only worth seeing played
    if ((e.target as HTMLInputElement).name === 'outro') replay();
  });
  panel.querySelector('[data-boot]')!.addEventListener('click', replay);
  panel.querySelector('[data-reset]')!.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch {}
    fill(defaults);
    apply(defaults);
  });
</script>
