---
// home's ticker: a purple strip of what's new, under the hero. it steps
// across a character at a time once, when it scrolls into view, then rests
// (nothing loops on its own): at rest it's a plain line you can scroll, tab
// through or read, and replay runs it again. pointing at it or focusing in
// stops a pass where you'd want to click. without js it's the resting line.
// every item is something the site already says, or live: the visit count
// and the newest guestbook message fill in when they arrive.
import { person, homelab } from '../data/profile';
import { build } from '../data/build';
import { getPosts } from '../data/buildFs';
import { api } from '../data/api';

const base = import.meta.env.BASE_URL;
const [post] = await getPosts();
const commit = build.log[0];
const ft = homelab.failureTest;
---

<aside class="ticker" aria-label="Latest" data-ticker>
  <div class="ticker-view">
    <ul class="ticker-track">
      <li><b>now</b> {person.now}</li>
      {commit && (
        <li><b>last commit</b> <a href={`${build.repo}/commit/${commit.sha}`}>{commit.sha.slice(0, 7)}</a> {commit.subject}</li>
      )}
      {post && (
        <li><b>newest post</b> <a href={`${base}blog/${post.id}/`}>{post.data.title}</a></li>
      )}
      <li><b>homelab</b> <a href={`${base}homelab/#failure-drill`}>{ft.trials} failure trials</a>, mean time to alert {ft.meanAlert}</li>
      <li data-views hidden><b>you</b> visitor #<span data-views-n></span> <span data-views-rem></span></li>
      {api && <li data-ticker-gb hidden><b>guestbook</b> <a href={`${base}guestbook/`} data-ticker-gb-msg></a></li>}
    </ul>
  </div>
  <button type="button" class="ticker-replay js-only" data-ticker-replay aria-label="Replay the ticker">replay</button>
</aside>

<script>
  // a page script: runs once per session, so set up on every page-load that
  // lands on home, with a marker so it's never wired twice
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // the newest guestbook message, from the teaser's fetch (one request, not two)
  const fillGb = () => {
    const m = (window as any).__modul0GbLatest;
    const li = document.querySelector<HTMLElement>('[data-ticker-gb]');
    if (!m || !li) return;
    const text = m.message.length > 70 ? `${m.message.slice(0, 69).trimEnd()}…` : m.message;
    // user-written: textContent only
    li.querySelector('[data-ticker-gb-msg]')!.textContent = `“${text}” (${m.name})`;
    li.hidden = false;
  };
  window.addEventListener('modul0:gb-latest', fillGb);

  function setupTicker() {
    const root = document.querySelector<HTMLElement>('[data-ticker]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    fillGb();
    const view = root.querySelector<HTMLElement>('.ticker-view')!;
    const track = root.querySelector<HTMLElement>('.ticker-track')!;
    let timer = 0;

    const rest = () => {
      clearInterval(timer);
      timer = 0;
      root.classList.remove('is-running');
      track.style.transform = '';
    };
    // one pass: in from the right edge, out past the left, a character a step
    const pass = () => {
      if (reduced()) return;
      rest();
      view.scrollLeft = 0;
      const ch = parseFloat(getComputedStyle(track).fontSize) * 0.6;
      let x = view.clientWidth;
      root.classList.add('is-running');
      track.style.transform = `translateX(${x}px)`;
      timer = window.setInterval(() => {
        x -= ch;
        // the width's read each step: live items can land mid-pass
        if (x < -track.scrollWidth) return rest();
        track.style.transform = `translateX(${Math.round(x)}px)`;
      }, 40);
    };

    // whatever you do to it, it stops where it can be read and clicked. a tap
    // on a moving link would land on whatever slid under your finger, so
    // that first tap only stops it
    let swallow = false;
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && timer) rest(); });
    root.addEventListener('pointerdown', () => { if (timer) { swallow = true; rest(); } });
    root.addEventListener('click', (e) => {
      if (swallow && !(e.target as HTMLElement).closest('[data-ticker-replay]')) e.preventDefault();
      swallow = false;
    }, true);
    root.addEventListener('focusin', (e) => { if (!(e.target as HTMLElement).closest('[data-ticker-replay]')) rest(); });
    root.querySelector('[data-ticker-replay]')!.addEventListener('click', () => { swallow = false; pass(); });

    // the first pass waits until you can see it
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      pass();
    }, { threshold: 0.6 });
    io.observe(root);
    document.addEventListener('astro:before-swap', () => { io.disconnect(); rest(); }, { once: true });
  }
  setupTicker();
  document.addEventListener('astro:page-load', setupTicker);
</script>
