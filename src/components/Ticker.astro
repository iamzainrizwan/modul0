---
// home's ticker: a strip of what's new under the hero, purple on black. it
// loops for good, a character a step (zain's call, over the qa rule that
// nothing loops on its own), so it holds still whenever you might want to
// read or click it: while pointed at or pressed, while anything in it has
// focus, while it's off screen, and always for reduced motion. still, it's a
// plain line you can scroll and tab through; that's all it is without js.
// every item is something the site already says, or live: the visit count
// and the newest guestbook message fill in when they arrive.
import { person, homelab } from '../data/profile';
import { build } from '../data/build';
import { getPosts } from '../data/buildFs';
import { api } from '../data/api';

const base = import.meta.env.BASE_URL;
const [post] = await getPosts();
const commit = build.log[0];
const ft = homelab.failureTest;
---

<aside class="ticker" aria-label="Latest" data-ticker>
  <div class="ticker-view">
    <div class="ticker-strip">
      <ul class="ticker-track">
        <li><b>now</b> {person.now}</li>
        {commit && (
          <li><b>last commit</b> <a href={`${build.repo}/commit/${commit.sha}`}>{commit.sha.slice(0, 7)}</a> {commit.subject}</li>
        )}
        {post && (
          <li><b>newest post</b> <a href={`${base}blog/${post.id}/`}>{post.data.title}</a></li>
        )}
        <li><b>homelab</b> <a href={`${base}homelab/#failure-drill`}>{ft.trials} failure trials</a>, mean time to alert {ft.meanAlert}</li>
        <li data-views hidden><b>you</b> visitor #<span data-views-n></span> <span data-views-rem></span></li>
        {api && <li data-ticker-gb hidden><b>guestbook</b> <a href={`${base}guestbook/`} data-ticker-gb-msg></a></li>}
      </ul>
    </div>
  </div>
</aside>

<script>
  // a page script: runs once per session, so set up on every page-load that
  // lands on home, with a marker so it's never wired twice
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // the newest guestbook message, from the teaser's fetch (one request, not two)
  const fillGb = () => {
    const m = (window as any).__modul0GbLatest;
    const li = document.querySelector<HTMLElement>('[data-ticker-gb]');
    if (!m || !li) return;
    const text = m.message.length > 70 ? `${m.message.slice(0, 69).trimEnd()}…` : m.message;
    // user-written: textContent only
    li.querySelector('[data-ticker-gb-msg]')!.textContent = `“${text}” (${m.name})`;
    li.hidden = false;
  };
  window.addEventListener('modul0:gb-latest', fillGb);

  function setupTicker() {
    const root = document.querySelector<HTMLElement>('[data-ticker]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    fillGb();
    if (reduced()) return;
    const view = root.querySelector<HTMLElement>('.ticker-view')!;
    const strip = root.querySelector<HTMLElement>('.ticker-strip')!;
    const track = strip.querySelector<HTMLElement>('.ticker-track')!;

    // the loop is the list twice over: when the first copy has gone by, jump
    // back by its width and nothing seems to move. the copy is only there to
    // be seen: hidden from screen readers, out of the tab order. it's
    // re-copied each lap, so live items that landed since show up in it
    let copy: HTMLElement | null = null;
    const recopy = () => {
      const c = track.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      c.inert = true;
      if (copy) copy.replaceWith(c);
      else strip.append(c);
      copy = c;
    };

    let x = 0;
    let running = false;
    const hold = { hover: false, press: false, focus: false, away: true };
    const start = () => {
      if (running) return;
      running = true;
      view.scrollLeft = 0;
      recopy();
      root.classList.add('is-running');
    };
    // back to the plain line, where focus can scroll to whatever it lands on
    const still = () => {
      running = false;
      x = 0;
      strip.style.transform = '';
      copy?.remove();
      copy = null;
      root.classList.remove('is-running');
    };
    const timer = window.setInterval(() => {
      if (!running || hold.hover || hold.press || hold.away) return;
      x -= parseFloat(getComputedStyle(track).fontSize) * 0.6;
      const lap = track.offsetWidth;
      if (-x >= lap) {
        x += lap;
        recopy();
      }
      strip.style.transform = `translateX(${Math.round(x)}px)`;
    }, 40);

    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hold.hover = true; });
    root.addEventListener('pointerleave', () => { hold.hover = false; hold.press = false; });
    // a tap stops it on the way down, so it lands on what was under the finger
    root.addEventListener('pointerdown', () => (hold.press = true));
    root.addEventListener('pointerup', () => (hold.press = false));
    root.addEventListener('pointercancel', () => (hold.press = false));
    root.addEventListener('focusin', () => { hold.focus = true; still(); });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      hold.focus = false;
      start();
    });
    // only moves while you can see it
    const io = new IntersectionObserver((entries) => (hold.away = !entries.some((e) => e.isIntersecting)));
    io.observe(root);
    start();
    document.addEventListener('astro:before-swap', () => { io.disconnect(); clearInterval(timer); }, { once: true });
  }
  setupTicker();
  document.addEventListener('astro:page-load', setupTicker);
</script>
