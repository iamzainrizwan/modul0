---
// the % mark: two solid squares and a hard slash, square corners only.
// squares take --mark-sq (purple by default), the slash takes currentColor,
// so hover states can flip it in one place.
---

<svg class="mod-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect class="mod-sq" x="0" y="0" width="8" height="8" />
  <rect class="mod-sq" x="16" y="16" width="8" height="8" />
  <polygon points="0,24 4,24 24,0 20,0" fill="currentColor" />
</svg>
