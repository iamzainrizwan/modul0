---
// s3ntry's deploy path and monitoring loop, as a diagram. it's a real
// sequence, so the steps are numbered. a pulse travels the connectors
// (css only, stops for reduced motion).
const steps = [
  { title: 'git push', text: 'to main on GitHub' },
  { title: 'Self-hosted runner', text: 'GitHub Actions job runs on alexandria itself' },
  { title: 'CI gate', text: 'build and checks must pass, or nothing ships' },
  { title: 'Deploy', text: 'as the non-root s3ntry user, over SSH deploy keys' },
  { title: 'Running', text: 'services up behind nginx, with a rollback path' },
];
---

<div class="pipeline" aria-label="How a change reaches alexandria">
  <ol class="steps">
    {steps.map((s, i) => (
      <li class="step" style={`--i:${i}`}>
        <span class="step-n">{i + 1}</span>
        <span class="step-title">{s.title}</span>
        <span class="step-text">{s.text}</span>
      </li>
    ))}
  </ol>
  <div class="loop">
    <div class="loop-node">
      <span class="loop-title">Health daemon</span>
      <span class="loop-text">Go, one goroutine per service, every 10s, plus host checks</span>
    </div>
    <div class="loop-link" aria-hidden="true"><span></span></div>
    <div class="loop-node">
      <span class="loop-title">Slack and Discord</span>
      <span class="loop-text">alert on down, and again on recovery</span>
    </div>
  </div>
</div>
