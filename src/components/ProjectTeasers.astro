---
// home's projects teaser: the featured three as cards that open their full
// write-up on /projects/, then every other project by name.
import type { Project } from '../data/profile';
import { plain } from '../data/inline';

interface Props {
  featured: Project[];
  archive: Project[];
}
const { featured, archive } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: Project) => `${base}projects/#project-${p.slug}`;
---

<ul class="teasers">
  {featured.map((p) => (
    <li>
      <a class="teaser" href={href(p)}>
        <span class="teaser-top">
          <span class={`status status-${p.status}`}><span class="status-dot" aria-hidden="true" />{p.statusText}</span>
          <span class="year">{p.year}</span>
        </span>
        <span class="teaser-name">{p.name}</span>
        <span class="teaser-tagline">{p.tagline}</span>
        <span class="teaser-summary">{plain(p.summary)}</span>
        <span class="teaser-stack">{p.stack.join(' · ')}</span>
        <span class="teaser-go">Read the details <span aria-hidden="true">-&gt;</span></span>
      </a>
    </li>
  ))}
</ul>
<div class="also">
  <span class="also-h">Also built</span>
  <ul>
    {archive.map((p) => <li><a href={href(p)}>{p.name}</a></li>)}
  </ul>
</div>
